# Скопируйте в .env и заполните.

# Состояние приложения и конфиг rclone. Создайте каталог заранее.
CF_DATA=/home/umbrel/cloud-ferry

# Куда скачивать файлы. Должно быть видно в Files (Home или внешний диск).
CF_DEST=/home/umbrel/umbrel/home/YandexDisk

# Вход в интерфейс. Обязательно задайте свои значения: приложение слушает LAN.
CF_BASIC_USER=umbrel
CF_BASIC_PASS=замените-на-длинный-пароль

# Внутренний пароль rclone. Сгенерируйте: openssl rand -hex 16
RC_PASS=замените-на-случайный

# Необязательно: своё OAuth-приложение Яндекса. Если задать оба значения,
# вход по коду не спрашивает ID и секрет у пользователя. Redirect URI не нужен.
# Секрет останется в этой инфраструктуре: он попадает в окружение api и в
# конфиг rclone на сервере, чтобы rclone обновлял токен. Не публикуйте его.
# CF_YANDEX_CLIENT_ID=
# CF_YANDEX_CLIENT_SECRET=
